{
  "name": "anna-vetolayer",
  "version": "0.1.0",
  "private": true,
  "description": "An Anna-native approval checkpoint for consequential AI-agent actions.",
  "engines": {
    "node": ">=22.0.0"
  },
  "packageManager": "pnpm@10.17.1",
  "scripts": {
    "dev": "anna-app dev",
    "dev:mock": "anna-app dev --mock-llm fixtures/context-review.jsonl",
    "validate": "anna-app validate --strict",
    "test": "node --test executas/policy-engine/policy-engine.test.js tests/*.test.js",
    "smoke": "node scripts/smoke-plugin.js",
    "build:executa": "node executas/policy-engine/scripts/build-binary.mjs",
    "package:executa": "node executas/policy-engine/scripts/package-binary.mjs",
    "verify:executa": "node executas/policy-engine/scripts/verify-package.mjs",
    "release:executa": "node executas/policy-engine/scripts/build-binary.mjs && node executas/policy-engine/scripts/package-binary.mjs && node executas/policy-engine/scripts/verify-package.mjs"
  },
  "devDependencies": {
    "@anna-ai/cli": "0.1.58",
    "postject": "1.0.0-alpha.6"
  }
}
